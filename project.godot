; Engine configuration file.
; PERFUME EMPIRE — Build Your Fragrance House (Godot 4.5, Compatibility renderer, 2D portrait)

config_version=5

[application]

config/name="Perfume Empire"
config/description="Build a fragrance house from a tiny laboratory into an international luxury group."
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.06, 0.08, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/quit_on_go_back=false

[autoload]

DB="*res://scripts/autoload/db.gd"
G="*res://scripts/autoload/game.gd"
Save="*res://scripts/autoload/save.gd"
Snd="*res://scripts/autoload/snd.gd"
Monet="*res://scripts/autoload/monet.gd"
Router="*res://scripts/autoload/router.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=780
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[internationalization]

locale/include_text_server_data=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.08, 1)
2d/snap/snap_2d_transforms_to_pixel=false
